---
/**
 * The coded oak-leaf-and-flame mark (blueprint §2 MEDIUM: coded, crisp at any size).
 * Single line weight (1.75), currentColor, no fills.
 * No inline style attribute (CSP style-src 'self'): size via the global .mark
 * class (var(--mark-size)) or a caller-supplied class.
 */
interface Props {
  class?: string;
}
const { class: className = 'mark' } = Astro.props;
---

<svg
  class={className}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.75"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  <!-- Flame outline -->
  <path
    d="M12 22c4.6 0 7.2-2.9 7.2-6.6 0-2.9-1.7-5.2-3.3-7.2C14.4 6.3 13.3 4.2 13 2c-2.2 1.5-3.2 3.5-3.3 5.4-.1 1.3.2 2.5.8 3.6-1.2-.4-2.1-1.2-2.7-2.3-1.6 1.7-3 4-3 6.7C4.8 19.1 7.4 22 12 22Z"
  />
  <!-- Oak-leaf vein and lobes inside the flame -->
  <path d="M12 18.5v-7.3" />
  <path d="M12 13.4c-1.1-.2-1.9-.9-2.3-1.9" />
  <path d="M12 15.6c1.1-.2 1.9-.9 2.3-1.9" />
</svg>
