---
/** FOUNDATION STUB — replaced by the hero parcel. */
interface Props {
  eyebrow: string;
  headline: string;
  subhead: string;
  alt: string;
  cue: string;
}
const { eyebrow, headline, subhead, cue } = Astro.props;
---

<section class="hero">
  <div class="hero__text">
    <p class="hero__eyebrow roast-log-label">{eyebrow}</p>
    <h1 class="hero__headline">{headline}</h1>
    <hr class="hero__rule" />
    <p class="hero__subhead">{subhead}</p>
    <a href="#roasts" class="hero__cue">{cue} ↓</a>
  </div>
</section>

<style>
  .hero {
    min-height: 88svh;
    max-height: calc(var(--space-10) * 7);
    display: flex;
    align-items: flex-end;
    background: var(--bg-base);
    background-image: var(--drum-glow);
    padding: 0 var(--space-5) var(--space-9);
  }
  .hero__text {
    max-width: calc(var(--space-10) * 10);
    margin: 0 auto;
    width: 100%;
  }
  .hero__eyebrow {
    color: var(--text-muted);
  }
  .hero__headline {
    font-size: var(--step-display-xl);
    line-height: var(--lh-tight);
    max-width: 16ch;
    margin: var(--space-3) 0;
  }
  .hero__rule {
    border: none;
    border-top: var(--hairline) solid var(--oak);
    width: var(--oak-rule-w);
    margin: var(--space-4) 0;
  }
  .hero__subhead {
    color: var(--text-secondary);
    font-size: var(--step-body-l);
    max-width: 46ch;
  }
  .hero__cue {
    display: inline-flex;
    align-items: center;
    min-height: var(--hit-target);
    color: var(--accent-text);
    text-decoration: none;
    margin-top: var(--space-4);
  }
</style>
