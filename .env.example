# Ember & Oak — environment variables
# Copy to .env for local development. Values here are placeholders, not real keys.

# Supplied by the host in production; the server binds to it.
PORT=4321
HOST=0.0.0.0
NODE_ENV=development

# Airtable — read-only personal access token scoped to data.records:read on the content base.
AIRTABLE_API_KEY=your-airtable-read-only-token-here
AIRTABLE_BASE_ID=your-airtable-base-id-here

# Table names (defaults match the created base; override only if you rename tables in Airtable).
AIRTABLE_CONTENT_TABLE=Page Content
AIRTABLE_ROASTS_TABLE=Roast Profiles

# How long an Airtable read is reused before refreshing, in seconds.
CONTENT_CACHE_TTL_SECONDS=60

# Canonical public address, used in the canonical tag, sharing card and sitemap.
SITE_URL=http://localhost:4321
