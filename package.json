{
  "name": "ember-oak",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Ember & Oak — small-batch coffee roasters. One-page site, server-rendered from Airtable with committed fallbacks.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "start": "node ./dist/server/entry.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lint:tokens": "node scripts/lint-tokens.mjs",
    "check": "astro check"
  },
  "dependencies": {
    "@astrojs/node": "9.5.5",
    "@fontsource-variable/fraunces": "5.3.0",
    "@fontsource-variable/karla": "5.3.0",
    "@tailwindcss/vite": "4.3.3",
    "astro": "5.18.2",
    "lucide-astro": "0.556.0",
    "tailwindcss": "4.3.3",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
